{
  "manifest_version": 3,
  "name": "Clean Copy",
  "version": "1.3.1",
  "description": "Automatically removes unwanted ending spaces and trailing newlines when copying text.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Clean Copy"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://docs.google.com/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
